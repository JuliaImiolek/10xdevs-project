# Supabase (Dashboard → Settings → API)
SUPABASE_URL=###
SUPABASE_KEY=###
SUPABASE_SERVICE_ROLE_KEY=###

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=###

# App URL (e.g. https://your-app.example.com) – used for auth links
SITE_URL=

# Optional: restrict generation error logs to admins
# GENERATION_ERROR_LOGS_ADMIN_ONLY=true
# ADMIN_USER_IDS=uuid1,uuid2

# Optional: seed default user (scripts/seed-default-user.mjs)
# DEFAULT_USER_ID=

# E2E tests use .env.test (SUPABASE_URL, SUPABASE_KEY, E2E_USERNAME, E2E_PASSWORD)
